{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Melos: Bootstrap",
      "type": "shell",
      "command": "melos bootstrap",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Melos: Analyze",
      "type": "shell",
      "command": "melos analyze",
      "group": "test",
      "dependsOn": ["Melos: Bootstrap"],
      "problemMatcher": ["$dart-build_runner"]
    },
    {
      "label": "Melos: Test",
      "type": "shell",
      "command": "melos test || true",
      "group": "test",
      "dependsOn": ["Melos: Bootstrap"],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Melos: Clean",
      "type": "shell",
      "command": "melos clean && find . -name pubspec.lock -delete",
      "group": "build",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Melos: gen:l10n",
      "type": "shell",
      "command": "melos gen:l10n",
      "group": "build",
      "dependsOn": ["Melos: Bootstrap"]
    },

    { "label": "Run: Tidash (Linux)", "type": "shell", "command": "melos run run:tidash:linux", "dependsOn": ["Melos: Bootstrap"] },
    { "label": "Run: Tidash (Web)", "type": "shell", "command": "melos run run:tidash:web", "dependsOn": ["Melos: Bootstrap"] },
    { "label": "Run: Tidaro (Android)", "type": "shell", "command": "melos run run:tidaro:android", "dependsOn": ["Melos: Bootstrap"] },
    { "label": "Run: Tidaro Mini (Web)", "type": "shell", "command": "melos run run:tidaro_mini:web", "dependsOn": ["Melos: Bootstrap"] },
    { "label": "Run: UI Kit Showcase (Linux)", "type": "shell", "command": "melos run run:ui_kit_showcase", "dependsOn": ["Melos: Bootstrap"] },

    { "label": "Build: Web (all)", "type": "shell", "command": "melos run build:web", "dependsOn": ["Melos: Bootstrap"] },
    { "label": "Build: Android (all)", "type": "shell", "command": "melos run build:android", "dependsOn": ["Melos: Bootstrap"] },

    {
      "label": "Format (dart fix + format)",
      "type": "shell",
      "command": "melos exec -- dart fix --apply && melos exec -- dart format .",
      "group": "build"
    },

    {
      "label": "Workspace: Reset Caches (Safe)",
      "type": "shell",
      "command": "find . -name pubspec.lock -delete && find . -name .dart_tool -type d -prune -exec rm -rf {} + && melos bootstrap",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
