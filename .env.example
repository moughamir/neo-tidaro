# Neo-Tidaro Environment Variables (example)
# Copy to .env and adjust values locally. Do NOT commit your actual .env.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=public-anon-key
# Optional service role key should never be used in clients
# SUPABASE_SERVICE_ROLE_KEY=service-role-key

# App configuration
APP_ENV=development
SENTRY_DSN=

# Flutter defines (use via --dart-define or flutter_dotenv)
# Example usage: flutter run --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
